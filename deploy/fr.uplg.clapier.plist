<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>fr.uplg.clapier</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/you/clapier/target/release/clapier</string>
        <string>--bind</string><string>0.0.0.0:80</string>
        <string>--overlay</string><string>/Users/you/clapier/garenne/overlay</string>
        <!-- launchd starts agents from /, so the adoption wants the
             absolute path to the brain -->
        <string>--garenne</string><string>/Users/you/clapier/garenne.bin</string>
        <string>--rabbit</string><string>192.168.1.155</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/Users/you/Library/Logs/clapier.log</string>
    <key>StandardErrorPath</key><string>/Users/you/Library/Logs/clapier.log</string>
    <key>EnvironmentVariables</key>
    <dict><key>RUST_LOG</key><string>info</string></dict>
</dict>
</plist>
