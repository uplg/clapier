// The Violet binary choreography format (.chor), translated into the
// sequencer's steps. True to the era: the format below was read out of
// Violet's own DanceGenerator.java (server side, the writer) and
// cross-checked against the surviving files and the community reader.
//
// Layout: 4 header bytes, one wait byte (skipped, like the original
// player), then a stream of <cmd> <args...> <dt>, where dt counts
// ticks of the current timescale (10 ms times the last tempo value,
// zero until a tempo command is seen). Commands:
//   0x01 tempo            | 0x07 led r g b 0 0   | 0x08 ear pos dir
//   0x09 all-leds r g b   | 0x0A led off          | 0x0E led palette
//   0x10 random midi (no synth here: skipped)     | 0x11 ear delta
//   0x12 ifne val hi lo (interactive jump: falls through)
//   0x13 wait ears+audio (skipped)                | 0x14 ear dir (skipped)
// LED bytes store 4 minus the hardware index; ear positions are
// twentieths of a turn (Violet gNbDents = 20) while our holes are
// seventeenths, so positions are rescaled.

const CHOR_MAX_STEPS = 4000;;

// The palette commands index a mood palette chosen server-side in the
// Violet era; index 7 is black by contract. This one leans violet.
fun _chor_palette i =
    if i == 0 then 0x7c5cff
    else if i == 1 then 0xff0000
    else if i == 2 then 0x00cc00
    else if i == 3 then 0x0000ff
    else if i == 4 then 0xffcc00
    else if i == 5 then 0x00ffff
    else if i == 6 then 0xff00ff
    else 0;;

fun _chor_rev l acc = if l == nil then acc else _chor_rev (tl l) ((hd l) :: acc);;

fun _chor_count l = if l == nil then 0 else 1 + _chor_count (tl l);;

// The language has no modulo operator; twentieths wrap by hand.
fun _chor_mod20 v =
    if v < 0 then _chor_mod20 (v + 20)
    else if v >= 20 then _chor_mod20 (v - 20)
    else v;;

// Chor led byte -> hardware led index, clamped into 0..4.
fun _chor_led b =
    let 4 - b -> n in
    if n < 0 then 0 else if n > 4 then 4 else n;;

// Twentieths of a turn -> our seventeen holes, rounded.
fun _chor_pos p = (((_chor_mod20 p) * 17) + 10) / 20;;

// Parse a .chor byte string into time-sorted sequencer steps, or nil
// when nothing playable is found. Lenient by design: an unknown or
// truncated command ends the parse and what was understood plays.
fun chor_parse data =
    if (data == nil) || ((strlen data) < 7) then nil
    else
    let strlen data -> len in
    let 5 -> i in            // header (4) + the first wait byte
    let 0 -> t in
    let 0 -> scale in
    let 0 -> e0 in let 0 -> e1 in
    let nil -> steps in
    let 0 -> n in
    let 0 -> stop in
    (
        while (!stop) && (i < len) && (n < CHOR_MAX_STEPS) do
        (
            let strget data i -> code in
            let
                if code == 0x01 then
                (
                    if (i + 1) < len then
                        set scale = 10 * (strget data (i + 1));
                    1
                )
                else if code == 0x07 then
                (
                    if (i + 4) < len then
                    (
                        set steps = [t CHO_LED (_chor_led (strget data (i + 1)))
                            (((strget data (i + 2)) << 16)
                             + ((strget data (i + 3)) << 8)
                             + (strget data (i + 4)))] :: steps;
                        set n = n + 1
                    );
                    6
                )
                else if code == 0x08 then
                (
                    if (i + 2) < len then
                    (
                        let strget data (i + 1) -> ear in
                        let _chor_mod20 (strget data (i + 2)) -> pos in
                        (
                            if ear == 0 then set e0 = pos else set e1 = pos;
                            set steps = [t CHO_EAR (ear & 1) (_chor_pos pos)] :: steps;
                            set n = n + 1
                        )
                    );
                    3
                )
                else if code == 0x09 then
                (
                    if (i + 3) < len then
                        let (((strget data (i + 1)) << 16)
                             + ((strget data (i + 2)) << 8)
                             + (strget data (i + 3))) -> rgb in
                        let 0 -> l in
                        while l < 5 do
                        (
                            set steps = [t CHO_LED l rgb] :: steps;
                            set n = n + 1;
                            set l = l + 1
                        );
                    3
                )
                else if code == 0x0A then
                (
                    if (i + 1) < len then
                    (
                        set steps = [t CHO_LED (_chor_led (strget data (i + 1))) 0] :: steps;
                        set n = n + 1
                    );
                    1
                )
                else if code == 0x0E then
                (
                    if (i + 2) < len then
                    (
                        set steps = [t CHO_LED (_chor_led (strget data (i + 1)))
                            (_chor_palette (7 & (strget data (i + 2))))] :: steps;
                        set n = n + 1
                    );
                    2
                )
                else if code == 0x10 then 0
                else if code == 0x11 then
                (
                    if (i + 2) < len then
                    (
                        let strget data (i + 1) -> ear in
                        let _chor_mod20
                            ((if ear == 0 then e0 else e1) + (strget data (i + 2))) -> np in
                        (
                            if ear == 0 then set e0 = np else set e1 = np;
                            set steps = [t CHO_EAR (ear & 1) (_chor_pos np)] :: steps;
                            set n = n + 1
                        )
                    );
                    2
                )
                else if code == 0x12 then 3
                else if code == 0x13 then 0
                else if code == 0x14 then 2
                else (set stop = 1; 0)
            -> nargs in
            (
                set i = i + 1 + nargs;
                if (!stop) && (i < len) then
                (
                    set t = t + ((strget data i) * scale);
                    set i = i + 1
                )
            )
        );
        if n == 0 then nil
        else _chor_rev ([(t + 400) CHO_END 0 0] :: steps) nil
    );;

// Parse and dance. Returns the number of steps, 0 when unplayable.
fun chor_play name data =
    let chor_parse data -> steps in
    if steps == nil then 0
    else (choreo_play name steps; _chor_count steps);;
